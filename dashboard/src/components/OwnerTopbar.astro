---
import NotificationBell from "./NotificationBell.astro";

export interface Props {
  title?: string;
}

const { title = "Dashboard" } = Astro.props;
---

<header class="sticky top-0 z-20 h-16 bg-surface/90 backdrop-blur border-b-2 border-ink flex items-center px-4 sm:px-6 gap-3 sm:gap-4 shrink-0">
  <!-- Mobile hamburger -->
  <button
    id="sidebar-toggle"
    type="button"
    aria-label="Buka navigasi"
    class="lg:hidden p-2 -ml-2 text-ink hover:text-signal transition-colors"
  >
    <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5" stroke="currentColor" stroke-width="2">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>

  <!-- Title -->
  <div class="min-w-0">
    <h1 class="font-display text-lg sm:text-2xl text-ink leading-none truncate">{title}</h1>
  </div>

  <div class="ml-auto flex items-center gap-2 sm:gap-3">
    <!-- Date badge -->
    <span id="topbar-date" class="hidden md:inline-flex items-center gap-1.5 font-mono text-[11px] text-steel border border-line px-2.5 py-1.5">
      <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5 text-smoke" stroke="currentColor" stroke-width="1.75">
        <rect x="3" y="4" width="18" height="18" rx="1"/><line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      —
    </span>

    <a href="/owner/reports" class="hidden sm:inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-widest text-ink border-2 border-ink px-3 py-1.5 hover:bg-ink hover:text-paper transition-colors duration-150">
      <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5" stroke="currentColor" stroke-width="1.75">
        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
      </svg>
      Laporan
    </a>

    <!-- Notifications -->
    <NotificationBell />
  </div>
</header>

<script>
  const dateEl = document.getElementById("topbar-date");
  if (dateEl) {
    const label = new Date().toLocaleDateString("id-ID", {
      weekday: "short",
      day: "numeric",
      month: "short",
      year: "numeric",
    });
    const icon = dateEl.querySelector("svg");
    dateEl.textContent = "";
    if (icon) dateEl.appendChild(icon);
    dateEl.append(label);
  }
</script>
