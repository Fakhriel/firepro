---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<DashboardLayout title="Invoices" activeNav="invoices">
  <PageHeader heading="Invoices" sub="Rekap tagihan &amp; pembayaran proyek" crumbs={[{ label: "Operasional" }, { label: "Invoices" }]}>
    <button id="btn-export-invoices" type="button" class="btn-secondary text-xs gap-1.5">
      <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5" stroke="currentColor" stroke-width="1.75">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/>
        <line x1="9" y1="15" x2="15" y2="15"/>
      </svg>
      Export PDF
    </button>
    <button id="btn-add-invoice" type="button" class="btn-primary text-xs gap-1.5">
      <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Tambah Invoice
    </button>
  </PageHeader>

  <!-- Filter -->
  <div class="flex flex-col sm:flex-row gap-3 mb-5">
    <input id="search-invoices" type="search" placeholder="Cari no. invoice / ID proyek…" class="field-input sm:max-w-xs" />
    <select id="filter-invoice-status" class="field-input sm:w-36">
      <option value="">Semua Status</option>
      <option value="paid">Lunas</option>
      <option value="pending">Pending</option>
      <option value="expired">Jatuh Tempo</option>
      <option value="failed">Ditolak</option>
      <option value="cancelled">Dibatalkan</option>
    </select>
  </div>

  <!-- Table -->
  <div class="panel overflow-hidden">
    <div class="overflow-x-auto">
      <table id="invoices-table" class="data-table hidden">
        <thead>
          <tr>
            <th>No. Invoice</th>
            <th class="hidden sm:table-cell">Project ID</th>
            <th>Metode</th>
            <th>Jumlah</th>
            <th class="hidden md:table-cell">Tanggal</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="invoices-body"></tbody>
      </table>
    </div>
    <div id="invoices-skeleton">
      {Array.from({ length: 5 }).map(() => (
        <div class="skeleton-row">
          <div class="skeleton w-9 h-9 shrink-0"></div>
          <div class="flex-1 space-y-2">
            <div class="skeleton h-3 w-1/3"></div>
            <div class="skeleton h-2.5 w-1/5"></div>
          </div>
          <div class="skeleton h-5 w-16 shrink-0"></div>
        </div>
      ))}
    </div>
    <div id="invoices-empty" class="empty-state min-h-56 hidden">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="1" y="4" width="22" height="16" rx="2"/>
        <line x1="1" y1="10" x2="23" y2="10"/>
      </svg>
      <p>Belum ada data invoice</p>
    </div>
    <div class="flex items-center justify-between px-4 py-3 border-t border-hairline">
      <span data-invoices-count class="font-mono text-[10px] text-smoke">0 invoice</span>
      <div class="flex items-center gap-1">
        <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" disabled>←</button>
        <span class="font-mono text-xs px-3 py-1.5 border border-hairline">1</span>
        <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" disabled>→</button>
      </div>
    </div>
  </div>

  <!-- Create invoice modal -->
  <div id="invoice-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/50 p-4">
    <div class="panel w-full max-w-md bg-surface">
      <div class="flex items-center justify-between px-5 py-4 border-b-2 border-ink">
        <h3 class="font-display text-lg text-ink leading-none">Tambah Invoice</h3>
        <button id="invoice-modal-close" type="button" class="text-steel hover:text-ink transition-colors" aria-label="Tutup">
          <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5" stroke="currentColor" stroke-width="1.75">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="p-5 space-y-4">
        <div>
          <label class="field-label" for="if-client">Klien</label>
          <select id="if-client" class="field-input">
            <option value="">Pilih klien…</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="if-project">Proyek <span class="text-smoke normal-case">(opsional)</span></label>
          <select id="if-project" class="field-input">
            <option value="">Pilih klien dulu…</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="field-label" for="if-amount">Jumlah (Rp)</label>
            <input id="if-amount" type="number" min="0" step="1" value="0" class="field-input" />
          </div>
          <div>
            <label class="field-label" for="if-issued-date">Tanggal Terbit</label>
            <input id="if-issued-date" type="date" class="field-input" />
          </div>
        </div>
        <div id="invoice-modal-error" class="hidden border-2 border-signal bg-signal/5 px-3 py-2">
          <p id="invoice-modal-error-msg" class="font-mono text-xs text-signal"></p>
        </div>
      </div>
      <div class="flex items-center justify-end gap-2 px-5 py-4 border-t border-hairline">
        <button id="invoice-modal-cancel" type="button" class="btn-secondary text-xs">Batal</button>
        <button id="invoice-modal-save" type="button" class="btn-primary text-xs">Simpan</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import { exportTableToPDF } from "../lib/export";
  import { adminApiFetch } from "../lib/auth";
  import { escapeHtml } from "../lib/escapeHtml";

  const apiUrl =
    document.getElementById("dashboard-root")?.dataset.apiUrl || "http://localhost:4000";

  interface AdminInvoice {
    invoiceNumber: string | null;
    projectId: string;
    amount: number;
    status: string;
    issuedDate: string;
    clientName: string;
  }

  let allInvoices: AdminInvoice[] = [];

  const tbody = document.getElementById("invoices-body") as HTMLTableSectionElement;
  const emptyState = document.getElementById("invoices-empty") as HTMLDivElement;
  const countLabel = document.querySelector<HTMLSpanElement>("[data-invoices-count]");
  const table = document.getElementById("invoices-table") as HTMLTableElement;
  const skeletonEl_invoices = document.getElementById("invoices-skeleton") as HTMLDivElement;

  const STATUS_LABELS: Record<string, string> = {
    pending: "Pending",
    paid: "Lunas",
    failed: "Ditolak",
    expired: "Jatuh Tempo",
    cancelled: "Dibatalkan",
  };
  const STATUS_CLASSES: Record<string, string> = {
    pending: "border-ink text-ink",
    paid: "border-armed bg-armed text-paper",
    failed: "border-signal text-signal",
    expired: "border-amber text-amber",
    cancelled: "border-smoke text-smoke",
  };

  function formatRupiah(value: number): string {
    return new Intl.NumberFormat("id-ID", {
      style: "currency", currency: "IDR", minimumFractionDigits: 0,
    }).format(value);
  }
  function formatDate(iso: string): string {
    return new Date(iso).toLocaleDateString("id-ID", {
      day: "2-digit", month: "short", year: "numeric",
    });
  }

  function renderTable(invoices: AdminInvoice[]): void {
    tbody.innerHTML = "";
    const isEmpty = invoices.length === 0;
    skeletonEl_invoices.classList.add("hidden");
    table.classList.toggle("hidden", isEmpty);
    emptyState.classList.toggle("hidden", !isEmpty);
    if (countLabel) countLabel.textContent = `${invoices.length} invoice`;

    invoices.forEach((inv) => {
      const statusLabel = STATUS_LABELS[inv.status] ?? inv.status;
      const statusClass = STATUS_CLASSES[inv.status] ?? "border-smoke text-smoke";
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td class="font-mono text-xs break-all">${escapeHtml(inv.invoiceNumber ?? "—")}</td>
        <td class="hidden sm:table-cell font-mono text-xs text-smoke">${escapeHtml(inv.projectId)}</td>
        <td class="font-mono text-xs text-smoke">Transfer Bank</td>
        <td class="font-mono text-xs">${formatRupiah(inv.amount)}</td>
        <td class="hidden md:table-cell font-mono text-xs text-smoke">${formatDate(inv.issuedDate)}</td>
        <td>
          <span class="font-mono text-[10px] uppercase tracking-wide px-2 py-0.5 border-2 ${statusClass}">
            ${statusLabel}
          </span>
        </td>
      `;
      tbody.appendChild(tr);
    });
  }

  function applyFilters(): void {
    const keyword = (document.getElementById("search-invoices") as HTMLInputElement)?.value
      .trim().toLowerCase() ?? "";
    const status = (document.getElementById("filter-invoice-status") as HTMLSelectElement)?.value ?? "";

    const filtered = allInvoices.filter((inv) => {
      if (keyword && !(inv.invoiceNumber ?? "").toLowerCase().includes(keyword) &&
          !inv.projectId.toLowerCase().includes(keyword)) return false;
      if (status && inv.status !== status) return false;
      return true;
    });
    renderTable(filtered);
  }

  async function loadInvoices(): Promise<void> {
    try {
      const res = await adminApiFetch(`${apiUrl}/api/invoices/admin`);
      const json = await res.json();
      if (!res.ok) {
        window.showToast?.(json.error ?? "Gagal memuat data invoice", "error");
        return;
      }
      allInvoices = json.data ?? [];
      applyFilters();
    } catch {
      window.showToast?.("Tidak bisa terhubung ke server", "error");
    }
  }

  document.getElementById("search-invoices")?.addEventListener("input", applyFilters);
  document.getElementById("filter-invoice-status")?.addEventListener("change", applyFilters);

  document.getElementById("btn-export-invoices")?.addEventListener("click", () => {
    exportTableToPDF("invoices-table", { title: "Rekap Invoice", subtitle: "Data tagihan proyek FIREPRO" });
  });

  // ─── Create invoice modal ───────────────────────────────────────────
  interface ClientOption {
    id: number;
    name: string;
  }
  interface ProjectOption {
    id: number;
    projectName: string;
    clientId: number;
  }
  let clientOptions: ClientOption[] = [];
  let allProjectOptions: ProjectOption[] = [];

  function openModal(id: string): void {
    document.getElementById(id)?.classList.replace("hidden", "flex");
  }
  function closeModal(id: string): void {
    document.getElementById(id)?.classList.replace("flex", "hidden");
  }

  async function loadClientOptions(): Promise<void> {
    const select = document.getElementById("if-client") as HTMLSelectElement;
    try {
      const res = await adminApiFetch(`${apiUrl}/api/clients`);
      const json = await res.json();
      if (!res.ok) return;
      clientOptions = json.data ?? [];
      select.innerHTML =
        `<option value="">Pilih klien…</option>` +
        clientOptions.map((c) => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join("");
    } catch (err) {
      console.error("[loadClientOptions] gagal fetch backend:", err);
    }
  }

  async function loadProjectOptions(): Promise<void> {
    try {
      const res = await adminApiFetch(`${apiUrl}/api/projects/admin`);
      const json = await res.json();
      if (!res.ok) return;
      allProjectOptions = json.data ?? [];
    } catch (err) {
      console.error("[loadProjectOptions] gagal fetch backend:", err);
    }
  }

  function updateProjectOptionsForClient(clientId: string): void {
    const projectSelect = document.getElementById("if-project") as HTMLSelectElement;
    if (!clientId) {
      projectSelect.innerHTML = `<option value="">Pilih klien dulu…</option>`;
      return;
    }
    const filtered = allProjectOptions.filter((p) => String(p.clientId) === clientId);
    projectSelect.innerHTML =
      `<option value="">Tanpa proyek terkait</option>` +
      filtered.map((p) => `<option value="${p.id}">${escapeHtml(p.projectName)}</option>`).join("");
  }
  document.getElementById("if-client")?.addEventListener("change", (e) => {
    updateProjectOptionsForClient((e.target as HTMLSelectElement).value);
  });

  function resetInvoiceForm(): void {
    (document.getElementById("if-client") as HTMLSelectElement).value = "";
    updateProjectOptionsForClient("");
    (document.getElementById("if-amount") as HTMLInputElement).value = "0";
    (document.getElementById("if-issued-date") as HTMLInputElement).value = new Date().toISOString().split("T")[0];
    document.getElementById("invoice-modal-error")?.classList.add("hidden");
  }

  document.getElementById("btn-add-invoice")?.addEventListener("click", () => {
    resetInvoiceForm();
    openModal("invoice-modal");
  });
  document.getElementById("invoice-modal-close")?.addEventListener("click", () => closeModal("invoice-modal"));
  document.getElementById("invoice-modal-cancel")?.addEventListener("click", () => closeModal("invoice-modal"));

  function showInvoiceFormError(msg: string): void {
    const box = document.getElementById("invoice-modal-error");
    const msgEl = document.getElementById("invoice-modal-error-msg");
    if (msgEl) msgEl.textContent = msg;
    box?.classList.remove("hidden");
  }

  document.getElementById("invoice-modal-save")?.addEventListener("click", async () => {
    const clientId = (document.getElementById("if-client") as HTMLSelectElement).value;
    const projectId = (document.getElementById("if-project") as HTMLSelectElement).value;
    const amount = Number((document.getElementById("if-amount") as HTMLInputElement).value || 0);
    const issuedDate = (document.getElementById("if-issued-date") as HTMLInputElement).value;

    if (!clientId) return showInvoiceFormError("Klien wajib dipilih.");
    if (!issuedDate) return showInvoiceFormError("Tanggal terbit wajib diisi.");
    if (Number.isNaN(amount) || amount < 0) return showInvoiceFormError("Jumlah harus angka >= 0.");

    try {
      const res = await adminApiFetch(`${apiUrl}/api/invoices`, {
        method: "POST",
        body: JSON.stringify({
          clientId: Number(clientId),
          projectId: projectId ? Number(projectId) : null,
          amount,
          issuedDate,
        }),
      });
      const json = await res.json();
      if (!res.ok) {
        showInvoiceFormError(json.error ?? "Gagal membuat invoice");
        return;
      }
      window.showToast?.("Invoice berhasil dibuat");
      closeModal("invoice-modal");
      await loadInvoices();
    } catch (err) {
      console.error("[invoice-modal-save] gagal fetch backend:", err);
      showInvoiceFormError("Tidak bisa terhubung ke server");
    }
  });

  loadClientOptions();
  loadProjectOptions();
  loadInvoices();
</script>
