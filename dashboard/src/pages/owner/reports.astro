---
import OwnerLayout from "../../layouts/OwnerLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import StatCard from "../../components/StatCard.astro";
---

<OwnerLayout title="Reports" activeNav="reports">
  <PageHeader heading="Reports" sub="Laporan ROI — monitoring performa bisnis" crumbs={[{ label: "Gudang & Analitik" }, { label: "Reports" }]}>
    <select id="report-period" class="field-input text-xs w-40">
      <option value="this_month">Bulan Ini</option>
      <option value="last_month">Bulan Lalu</option>
      <option value="this_quarter">Kuartal Ini</option>
      <option value="this_year">Tahun Ini</option>
    </select>
    <button id="btn-export-report" type="button" class="btn-primary text-xs gap-1.5">
      <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5" stroke="currentColor" stroke-width="2">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/>
        <line x1="9" y1="15" x2="15" y2="15"/>
      </svg>
      Export Laporan
    </button>
  </PageHeader>

  <!-- Stat cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-8">
    <StatCard id="stat-report-revenue" label="Total Revenue" accent />
    <StatCard id="stat-report-cost" label="Total Biaya" />
    <StatCard id="stat-report-profit" label="Gross Profit" />
    <StatCard id="stat-report-roi" label="ROI %" />
  </div>

  <!-- Chart -->
  <div class="panel mb-8">
    <div class="px-5 py-4 border-b-2 border-ink">
      <h3 class="font-display text-lg text-ink leading-none">Omzet vs Biaya vs Laba</h3>
      <p class="font-mono text-[9px] text-smoke uppercase tracking-widest mt-1">Tren 12 bulan terakhir</p>
    </div>
    <div id="report-chart-container"></div>
  </div>

  <!-- Breakdown per project -->
  <div class="panel overflow-hidden mb-8">
    <div class="px-5 py-4 border-b-2 border-ink">
      <h3 class="font-display text-lg text-ink leading-none">Profitabilitas per Proyek</h3>
      <p class="font-mono text-[9px] text-smoke uppercase tracking-widest mt-1">Kontribusi laba tiap proyek</p>
    </div>
    <div class="overflow-x-auto">
      <table id="project-profit-table" class="data-table">
        <thead>
          <tr>
            <th>Proyek</th>
            <th class="hidden sm:table-cell">Klien</th>
            <th>Omzet</th>
            <th>Biaya</th>
            <th>Laba</th>
            <th class="hidden md:table-cell">Margin</th>
          </tr>
        </thead>
        <tbody id="project-profit-body"></tbody>
      </table>
    </div>
    <div id="project-profit-empty" class="empty-state min-h-52">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M5.5 8H18.5L19.5 21H4.5L5.5 8Z"/>
        <path d="M8.5 8V6C8.5 4.067 9.567 3 12 3C14.433 3 15.5 4.067 15.5 6V8"/>
      </svg>
      <p>Belum ada data profitabilitas proyek</p>
    </div>
  </div>

  <!-- Cashflow breakdown -->
  <div class="panel overflow-hidden">
    <div class="px-5 py-4 border-b-2 border-ink">
      <h3 class="font-display text-lg text-ink leading-none">Rincian Biaya</h3>
      <p class="font-mono text-[9px] text-smoke uppercase tracking-widest mt-1">Pengeluaran tercatat pada periode ini</p>
    </div>
    <div class="overflow-x-auto">
      <table id="report-table" class="data-table hidden">
        <thead>
          <tr>
            <th>Tanggal</th>
            <th>Kategori</th>
            <th class="hidden sm:table-cell">Keterangan</th>
            <th>Jumlah</th>
          </tr>
        </thead>
        <tbody id="report-body"></tbody>
      </table>
    </div>
    <div id="report-skeleton">
      {Array.from({ length: 5 }).map(() => (
        <div class="skeleton-row">
          <div class="skeleton w-9 h-9 shrink-0"></div>
          <div class="flex-1 space-y-2">
            <div class="skeleton h-3 w-1/3"></div>
            <div class="skeleton h-2.5 w-1/5"></div>
          </div>
          <div class="skeleton h-5 w-16 shrink-0"></div>
        </div>
      ))}
    </div>
    <div id="report-empty" class="empty-state min-h-52 hidden">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
      </svg>
      <p>Belum ada transaksi tercatat</p>
    </div>
  </div>
</OwnerLayout>

<script>
  import { adminApiFetch } from "../../lib/auth";
  import { escapeHtml } from "../../lib/escapeHtml";
  import { exportTableToPDF, formatIDR } from "../../lib/export";
  import { renderLineChart } from "../../lib/charts";

  const apiUrl =
    document.getElementById("dashboard-root")?.dataset.apiUrl || "http://localhost:4000";

  interface CostEntry {
    id: string;
    date: string;
    category: string;
    categoryLabel: string;
    amount: number;
    note: string;
  }

  const periodSelect = document.getElementById("report-period") as HTMLSelectElement | null;

  function setStatValue(cardId: string, value: string): void {
    const card = document.getElementById(cardId);
    if (!card) return;
    let valueEl = card.querySelector<HTMLParagraphElement>(".stat-value");
    if (!valueEl) {
      const skeleton = card.querySelector(".skeleton")?.parentElement;
      valueEl = document.createElement("p");
      const isAccent = card.classList.contains("bg-ink");
      valueEl.className = `stat-value font-display text-3xl sm:text-4xl leading-none ${isAccent ? "text-paper" : "text-ink"}`;
      if (skeleton) {
        skeleton.replaceWith(valueEl);
      } else {
        card.appendChild(valueEl);
      }
    }
    valueEl.textContent = value;
  }

  function formatDateReport(iso: string): string {
    try {
      return new Date(iso).toLocaleDateString("id-ID", { day: "2-digit", month: "short", year: "numeric" });
    } catch {
      return iso;
    }
  }

  async function loadSummary(): Promise<void> {
    try {
      const period = periodSelect?.value ?? "this_month";
      const res = await adminApiFetch(`${apiUrl}/api/owner/reports/summary?period=${period}`);
      const json = await res.json();
      if (!res.ok) {
        window.showToast?.(json.error ?? "Gagal memuat ringkasan laporan", "error");
        return;
      }
      const d = json.data?.kpi ?? {};
      setStatValue("stat-report-revenue", formatIDR(d.paidRevenue ?? 0));
      setStatValue("stat-report-cost", formatIDR(d.totalCost ?? 0));
      setStatValue("stat-report-profit", formatIDR(d.estimatedProfit ?? 0));
      setStatValue("stat-report-roi", `${d.roi ?? 0}%`);
    } catch (err) {
      console.error("[loadSummary] gagal fetch backend:", err);
      window.showToast?.("Tidak bisa terhubung ke server", "error");
    }
  }

  async function loadCosts(): Promise<void> {
    const tableBody = document.getElementById("report-body") as HTMLTableSectionElement;
    const emptyState = document.getElementById("report-empty") as HTMLDivElement;
    const table = document.getElementById("report-table") as HTMLTableElement;
  const skeletonEl_report = document.getElementById("report-skeleton") as HTMLDivElement;
    try {
      const period = periodSelect?.value ?? "this_month";
      const res = await adminApiFetch(`${apiUrl}/api/owner/reports/costs?period=${period}`);
      const json = await res.json();
      if (!res.ok) {
        window.showToast?.(json.error ?? "Gagal memuat rincian biaya", "error");
        return;
      }
      const costs: CostEntry[] = json.data ?? [];
      const isEmpty = costs.length === 0;
      skeletonEl_report.classList.add("hidden");
      table.classList.toggle("hidden", isEmpty);
      emptyState.classList.toggle("hidden", !isEmpty);

      tableBody.innerHTML = costs
        .map(
          (c) => `
        <tr>
          <td class="font-mono text-xs text-charcoal">${formatDateReport(c.date)}</td>
          <td class="font-semibold text-ink">${escapeHtml(c.categoryLabel)}</td>
          <td class="hidden sm:table-cell font-mono text-xs text-charcoal">${escapeHtml(c.note || "-")}</td>
          <td class="font-mono text-xs text-charcoal">${formatIDR(c.amount)}</td>
        </tr>
      `
        )
        .join("");
    } catch (err) {
      console.error("[loadCosts] gagal fetch backend:", err);
      window.showToast?.("Tidak bisa terhubung ke server", "error");
    }
  }

  interface ProjectRoiRow {
    projectId: number;
    projectName: string;
    clientName: string;
    contractValue: number;
    totalCost: number;
    estimatedProfit: number;
    margin: number;
    roi: number;
  }

  async function loadProjectProfitability(): Promise<void> {
    const tableBody = document.getElementById("project-profit-body") as HTMLTableSectionElement;
    const table = document.getElementById("project-profit-table") as HTMLTableElement;
    const emptyState = document.getElementById("project-profit-empty") as HTMLDivElement;
    try {
      const res = await adminApiFetch(`${apiUrl}/api/owner/reports/projects-roi`);
      const json = await res.json();
      if (!res.ok) {
        window.showToast?.(json.error ?? "Gagal memuat profitabilitas proyek", "error");
        return;
      }
      const rows: ProjectRoiRow[] = json.data ?? [];
      const isEmpty = rows.length === 0;
      table.classList.toggle("hidden", isEmpty);
      emptyState.classList.toggle("hidden", !isEmpty);

      tableBody.innerHTML = rows
        .map(
          (r) => `
        <tr>
          <td class="font-semibold text-ink">${escapeHtml(r.projectName)}</td>
          <td class="hidden sm:table-cell font-mono text-xs text-charcoal">${escapeHtml(r.clientName)}</td>
          <td class="font-mono text-xs text-charcoal">${formatIDR(r.contractValue)}</td>
          <td class="font-mono text-xs text-charcoal">${formatIDR(r.totalCost)}</td>
          <td class="font-mono text-xs text-charcoal">${formatIDR(r.estimatedProfit)}</td>
          <td class="hidden md:table-cell font-mono text-xs text-charcoal">${r.margin}%</td>
        </tr>
      `
        )
        .join("");
    } catch (err) {
      console.error("[loadProjectProfitability] gagal fetch backend:", err);
      window.showToast?.("Tidak bisa terhubung ke server", "error");
    }
  }

  async function loadTrendChart(): Promise<void> {
    const container = document.getElementById("report-chart-container");
    if (!container) return;
    try {
      const res = await adminApiFetch(`${apiUrl}/api/owner/reports/monthly-trend?months=12`);
      const json = await res.json();
      if (!res.ok) {
        window.showToast?.(json.error ?? "Gagal memuat grafik tren", "error");
        return;
      }
      const rows: { label: string; revenue: number; cost: number; profit: number }[] = json.data ?? [];
      renderLineChart(
        container,
        [
          { name: "Omzet", color: "#c22a1f", points: rows.map((r) => ({ label: r.label, value: r.revenue })) },
          { name: "Biaya", color: "#14181c", points: rows.map((r) => ({ label: r.label, value: r.cost })) },
          { name: "Laba", color: "#7a746a", points: rows.map((r) => ({ label: r.label, value: r.profit })) },
        ],
        formatIDR
      );
    } catch (err) {
      console.error("[loadTrendChart] gagal fetch backend:", err);
      window.showToast?.("Tidak bisa terhubung ke server", "error");
    }
  }

  function loadReports(): void {
    loadSummary();
    loadCosts();
    loadProjectProfitability();
    loadTrendChart();
  }

  periodSelect?.addEventListener("change", loadReports);

  document.getElementById("btn-export-report")?.addEventListener("click", () => {
    exportTableToPDF("report-table", { title: "Rincian Biaya", subtitle: "Laporan FIREPRO — periode terpilih" });
  });

  loadReports();
</script>
