---
import OwnerLayout from "../../layouts/OwnerLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import StatCard from "../../components/StatCard.astro";
---

<OwnerLayout title="Invoices" activeNav="invoices">
  <PageHeader heading="Invoices" sub="Rekap tagihan & pembayaran proyek" crumbs={[{ label: "Operasional" }, { label: "Invoices" }]}>
    <button id="btn-export-invoices" type="button" class="btn-secondary text-xs gap-1.5">
      <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5" stroke="currentColor" stroke-width="1.75">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/>
        <line x1="9" y1="15" x2="15" y2="15"/>
      </svg>
      Export PDF
    </button>
    <button id="btn-add-invoice" type="button" class="btn-primary text-xs gap-1.5">
      <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Tambah Invoice
    </button>
  </PageHeader>

  <!-- Stat cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-8">
    <StatCard id="stat-invoices-total" label="Total Tagihan" accent />
    <StatCard id="stat-invoices-paid" label="Sudah Dibayar" />
    <StatCard id="stat-invoices-unpaid" label="Belum Dibayar" />
    <StatCard id="stat-invoices-overdue" label="Gagal / Dibatalkan" />
  </div>

  <!-- Filter -->
  <div class="flex flex-col sm:flex-row gap-3 mb-5">
    <input id="search-invoices" type="search" placeholder="Cari no. invoice / klien…" class="field-input sm:max-w-xs" />
    <select id="filter-invoice-status" class="field-input sm:w-40">
      <option value="">Semua Status</option>
      <option value="paid">Lunas</option>
      <option value="pending">Belum Bayar</option>
      <option value="failed">Gagal</option>
      <option value="expired">Kedaluwarsa</option>
      <option value="cancelled">Dibatalkan</option>
    </select>
  </div>

  <!-- Table -->
  <div class="panel overflow-hidden">
    <div class="overflow-x-auto">
      <table id="invoices-table" class="data-table hidden">
        <thead>
          <tr>
            <th>No. Invoice</th>
            <th>Klien</th>
            <th class="hidden sm:table-cell">Proyek</th>
            <th>Jumlah</th>
            <th class="hidden md:table-cell">Tanggal Terbit</th>
            <th>Status</th>
            <th class="text-right">Aksi</th>
          </tr>
        </thead>
        <tbody id="invoices-body"></tbody>
      </table>
    </div>
    <div id="invoices-skeleton">
      {Array.from({ length: 5 }).map(() => (
        <div class="skeleton-row">
          <div class="skeleton w-9 h-9 shrink-0"></div>
          <div class="flex-1 space-y-2">
            <div class="skeleton h-3 w-1/3"></div>
            <div class="skeleton h-2.5 w-1/5"></div>
          </div>
          <div class="skeleton h-5 w-16 shrink-0"></div>
        </div>
      ))}
    </div>
    <div id="invoices-empty" class="empty-state min-h-56 hidden">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 2h16v20l-3-2-3 2-3-2-3 2-3-2-1 2z"/>
        <line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="16" y2="11"/>
      </svg>
      <p>Belum ada invoice diterbitkan</p>
    </div>
    <div class="flex items-center justify-between px-4 py-3 border-t border-hairline">
      <span data-invoices-count class="font-mono text-[10px] text-smoke">0 invoice</span>
      <div class="flex items-center gap-1">
        <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" disabled>←</button>
        <span class="font-mono text-xs px-3 py-1.5 border border-hairline">1</span>
        <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" disabled>→</button>
      </div>
    </div>
  </div>

  <!-- Create invoice modal -->
  <div id="invoice-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/50 p-4">
    <div class="panel w-full max-w-md bg-surface">
      <div class="flex items-center justify-between px-5 py-4 border-b-2 border-ink">
        <h3 class="font-display text-lg text-ink leading-none">Tambah Invoice</h3>
        <button id="invoice-modal-close" type="button" class="text-steel hover:text-ink transition-colors" aria-label="Tutup">
          <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5" stroke="currentColor" stroke-width="1.75">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="p-5 space-y-4">
        <div>
          <label class="field-label" for="if-client">Klien</label>
          <select id="if-client" class="field-input">
            <option value="">Pilih klien…</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="if-project">Proyek <span class="text-smoke normal-case">(opsional)</span></label>
          <select id="if-project" class="field-input">
            <option value="">Pilih klien dulu…</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="field-label" for="if-amount">Jumlah (Rp)</label>
            <input id="if-amount" type="number" min="0" step="1" value="0" class="field-input" />
          </div>
          <div>
            <label class="field-label" for="if-issued-date">Tanggal Terbit</label>
            <input id="if-issued-date" type="date" class="field-input" />
          </div>
        </div>
        <div id="invoice-modal-error" class="hidden border-2 border-signal bg-signal/5 px-3 py-2">
          <p id="invoice-modal-error-msg" class="font-mono text-xs text-signal"></p>
        </div>
      </div>
      <div class="flex items-center justify-end gap-2 px-5 py-4 border-t border-hairline">
        <button id="invoice-modal-cancel" type="button" class="btn-secondary text-xs">Batal</button>
        <button id="invoice-modal-save" type="button" class="btn-primary text-xs">Simpan</button>
      </div>
    </div>
  </div>
</OwnerLayout>

<script>
  import { adminApiFetch } from "../../lib/auth";
  import { escapeHtml } from "../../lib/escapeHtml";
  import { exportTableToPDF, formatIDR } from "../../lib/export";

  const apiUrl =
    document.getElementById("dashboard-root")?.dataset.apiUrl || "http://localhost:4000";

  interface InvoiceRow {
    id: number;
    invoiceNumber: string;
    projectId: string;
    amount: number;
    status: "pending" | "paid" | "failed" | "expired" | "cancelled";
    issuedDate: string;
    clientId: number;
    clientName: string;
  }

  const STATUS_LABEL: Record<string, string> = {
    pending: "Belum Bayar",
    paid: "Lunas",
    failed: "Gagal",
    expired: "Kedaluwarsa",
    cancelled: "Dibatalkan",
  };

  let allInvoices: InvoiceRow[] = [];

  const tableBody = document.getElementById("invoices-body") as HTMLTableSectionElement;
  const emptyState = document.getElementById("invoices-empty") as HTMLDivElement;
  const table = document.getElementById("invoices-table") as HTMLTableElement;
  const skeletonEl_invoices = document.getElementById("invoices-skeleton") as HTMLDivElement;
  const countLabel = document.querySelector("[data-invoices-count]") as HTMLElement | null;
  const searchInput = document.getElementById("search-invoices") as HTMLInputElement | null;
  const statusFilter = document.getElementById("filter-invoice-status") as HTMLSelectElement | null;

  function statusBadge(status: string): string {
    const map: Record<string, string> = {
      pending: "bg-hairline/30 text-smoke border-hairline",
      paid: "bg-ink text-paper border-ink",
      failed: "bg-signal/10 text-signal border-signal",
      expired: "bg-signal/10 text-signal border-signal",
      cancelled: "bg-signal/10 text-signal border-signal",
    };
    return map[status] ?? map.pending;
  }

  function setStatValue(cardId: string, value: string): void {
    const card = document.getElementById(cardId);
    if (!card) return;
    let valueEl = card.querySelector<HTMLParagraphElement>(".stat-value");
    if (!valueEl) {
      const skeleton = card.querySelector(".skeleton")?.parentElement;
      valueEl = document.createElement("p");
      const isAccent = card.classList.contains("bg-ink");
      valueEl.className = `stat-value font-display text-3xl sm:text-4xl leading-none ${isAccent ? "text-paper" : "text-ink"}`;
      if (skeleton) {
        skeleton.replaceWith(valueEl);
      } else {
        card.appendChild(valueEl);
      }
    }
    valueEl.textContent = value;
  }

  function renderTable(invoices: InvoiceRow[]): void {
    tableBody.innerHTML = "";

    const isEmpty = invoices.length === 0;
    skeletonEl_invoices.classList.add("hidden");
    table.classList.toggle("hidden", isEmpty);
    emptyState.classList.toggle("hidden", !isEmpty);
    if (countLabel) countLabel.textContent = `${invoices.length} invoice`;

    invoices.forEach((inv) => {
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td class="font-mono text-xs text-ink">${escapeHtml(inv.invoiceNumber)}</td>
        <td class="font-semibold text-ink">${escapeHtml(inv.clientName)}</td>
        <td class="hidden sm:table-cell font-mono text-xs text-charcoal">#${escapeHtml(inv.projectId)}</td>
        <td class="font-mono text-xs text-charcoal">${formatIDR(inv.amount)}</td>
        <td class="hidden md:table-cell font-mono text-xs text-charcoal">${inv.issuedDate ? new Date(inv.issuedDate).toLocaleDateString("id-ID") : "-"}</td>
        <td><span class="font-mono text-[9px] uppercase tracking-widest border px-2 py-1 ${statusBadge(inv.status)}">${escapeHtml(STATUS_LABEL[inv.status] ?? inv.status)}</span></td>
        <td class="text-right whitespace-nowrap">
          ${inv.status === "pending" ? `<button type="button" data-id="${inv.id}" class="btn-mark-paid text-xs text-steel hover:text-ink font-mono underline-offset-2 hover:underline mr-3">Tandai Lunas</button>` : ""}
          <button type="button" data-id="${inv.id}" data-number="${escapeHtml(inv.invoiceNumber)}" class="btn-delete-invoice text-xs text-steel hover:text-signal font-mono underline-offset-2 hover:underline">Hapus</button>
        </td>
      `;
      tableBody.appendChild(tr);
    });

    tableBody.querySelectorAll<HTMLButtonElement>(".btn-mark-paid").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        try {
          const res = await adminApiFetch(`${apiUrl}/api/owner/invoices/${id}`, {
            method: "PATCH",
            body: JSON.stringify({ status: "paid" }),
          });
          const json = await res.json();
          if (!res.ok) {
            window.showToast?.(json.error ?? "Gagal menandai invoice lunas", "error");
            return;
          }
          window.showToast?.("Invoice ditandai lunas");
          await loadInvoices();
        } catch {
          window.showToast?.("Tidak bisa terhubung ke server", "error");
        }
      });
    });

    tableBody.querySelectorAll<HTMLButtonElement>(".btn-delete-invoice").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const number = btn.dataset.number ?? "";
        if (!window.confirm(`Hapus invoice "${number}"? Aksi ini tidak bisa dibatalkan.`)) return;
        try {
          const res = await adminApiFetch(`${apiUrl}/api/owner/invoices/${id}`, { method: "DELETE" });
          const json = await res.json().catch(() => ({}));
          if (!res.ok) {
            window.showToast?.(json.error ?? "Gagal menghapus invoice", "error");
            return;
          }
          window.showToast?.("Invoice berhasil dihapus");
          await loadInvoices();
        } catch {
          window.showToast?.("Tidak bisa terhubung ke server", "error");
        }
      });
    });
  }

  function updateStats(invoices: InvoiceRow[]): void {
    const totalAmount = invoices.reduce((sum, inv) => sum + inv.amount, 0);
    const paid = invoices.filter((inv) => inv.status === "paid").length;
    const unpaid = invoices.filter((inv) => inv.status === "pending").length;
    const failedOrCancelled = invoices.filter((inv) => inv.status === "failed" || inv.status === "cancelled").length;

    setStatValue("stat-invoices-total", formatIDR(totalAmount));
    setStatValue("stat-invoices-paid", String(paid));
    setStatValue("stat-invoices-unpaid", String(unpaid));
    setStatValue("stat-invoices-overdue", String(failedOrCancelled));
  }

  async function loadInvoices(): Promise<void> {
    try {
      const params = new URLSearchParams();
      if (searchInput?.value) params.set("search", searchInput.value);
      if (statusFilter?.value) params.set("status", statusFilter.value);

      const res = await adminApiFetch(`${apiUrl}/api/owner/invoices/admin?${params.toString()}`);
      const json = await res.json();
      if (!res.ok) {
        window.showToast?.(json.error ?? "Gagal memuat data invoice", "error");
        return;
      }
      allInvoices = json.data ?? [];
      renderTable(allInvoices);
      updateStats(allInvoices);
    } catch (err) {
      console.error("[loadInvoices] gagal fetch backend:", err);
      window.showToast?.("Tidak bisa terhubung ke server", "error");
    }
  }

  let searchDebounce: ReturnType<typeof setTimeout>;
  searchInput?.addEventListener("input", () => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(loadInvoices, 300);
  });
  statusFilter?.addEventListener("change", loadInvoices);

  document.getElementById("btn-export-invoices")?.addEventListener("click", () => {
    exportTableToPDF("invoices-table", { title: "Daftar Invoice", subtitle: "Rekap tagihan & pembayaran proyek — FIREPRO" });
  });

  // ─── Create invoice modal ───────────────────────────────────────────
  interface ClientOption {
    id: number;
    name: string;
  }
  interface ProjectOption {
    id: number;
    projectName: string;
    clientId: number;
  }
  let clientOptions: ClientOption[] = [];
  let allProjectOptions: ProjectOption[] = [];

  function openModal(id: string): void {
    document.getElementById(id)?.classList.replace("hidden", "flex");
  }
  function closeModal(id: string): void {
    document.getElementById(id)?.classList.replace("flex", "hidden");
  }

  async function loadClientOptions(): Promise<void> {
    const select = document.getElementById("if-client") as HTMLSelectElement;
    try {
      const res = await adminApiFetch(`${apiUrl}/api/owner/clients`);
      const json = await res.json();
      if (!res.ok) return;
      clientOptions = json.data ?? [];
      select.innerHTML =
        `<option value="">Pilih klien…</option>` +
        clientOptions.map((c) => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join("");
    } catch (err) {
      console.error("[loadClientOptions] gagal fetch backend:", err);
    }
  }

  async function loadProjectOptions(): Promise<void> {
    try {
      const res = await adminApiFetch(`${apiUrl}/api/owner/projects/admin`);
      const json = await res.json();
      if (!res.ok) return;
      allProjectOptions = json.data ?? [];
    } catch (err) {
      console.error("[loadProjectOptions] gagal fetch backend:", err);
    }
  }

  function updateProjectOptionsForClient(clientId: string): void {
    const projectSelect = document.getElementById("if-project") as HTMLSelectElement;
    if (!clientId) {
      projectSelect.innerHTML = `<option value="">Pilih klien dulu…</option>`;
      return;
    }
    const filtered = allProjectOptions.filter((p) => String(p.clientId) === clientId);
    projectSelect.innerHTML =
      `<option value="">Tanpa proyek terkait</option>` +
      filtered.map((p) => `<option value="${p.id}">${escapeHtml(p.projectName)}</option>`).join("");
  }
  document.getElementById("if-client")?.addEventListener("change", (e) => {
    updateProjectOptionsForClient((e.target as HTMLSelectElement).value);
  });

  function resetInvoiceForm(): void {
    (document.getElementById("if-client") as HTMLSelectElement).value = "";
    updateProjectOptionsForClient("");
    (document.getElementById("if-amount") as HTMLInputElement).value = "0";
    (document.getElementById("if-issued-date") as HTMLInputElement).value = new Date().toISOString().split("T")[0];
    document.getElementById("invoice-modal-error")?.classList.add("hidden");
  }

  document.getElementById("btn-add-invoice")?.addEventListener("click", () => {
    resetInvoiceForm();
    openModal("invoice-modal");
  });
  document.getElementById("invoice-modal-close")?.addEventListener("click", () => closeModal("invoice-modal"));
  document.getElementById("invoice-modal-cancel")?.addEventListener("click", () => closeModal("invoice-modal"));

  function showInvoiceFormError(msg: string): void {
    const box = document.getElementById("invoice-modal-error");
    const msgEl = document.getElementById("invoice-modal-error-msg");
    if (msgEl) msgEl.textContent = msg;
    box?.classList.remove("hidden");
  }

  document.getElementById("invoice-modal-save")?.addEventListener("click", async () => {
    const clientId = (document.getElementById("if-client") as HTMLSelectElement).value;
    const projectId = (document.getElementById("if-project") as HTMLSelectElement).value;
    const amount = Number((document.getElementById("if-amount") as HTMLInputElement).value || 0);
    const issuedDate = (document.getElementById("if-issued-date") as HTMLInputElement).value;

    if (!clientId) return showInvoiceFormError("Klien wajib dipilih.");
    if (!issuedDate) return showInvoiceFormError("Tanggal terbit wajib diisi.");
    if (Number.isNaN(amount) || amount < 0) return showInvoiceFormError("Jumlah harus angka >= 0.");

    try {
      const res = await adminApiFetch(`${apiUrl}/api/owner/invoices`, {
        method: "POST",
        body: JSON.stringify({
          clientId: Number(clientId),
          projectId: projectId ? Number(projectId) : null,
          amount,
          issuedDate,
        }),
      });
      const json = await res.json();
      if (!res.ok) {
        showInvoiceFormError(json.error ?? "Gagal membuat invoice");
        return;
      }
      window.showToast?.("Invoice berhasil dibuat");
      closeModal("invoice-modal");
      await loadInvoices();
    } catch (err) {
      console.error("[invoice-modal-save] gagal fetch backend:", err);
      showInvoiceFormError("Tidak bisa terhubung ke server");
    }
  });

  loadClientOptions();
  loadProjectOptions();
  loadInvoices();
</script>
