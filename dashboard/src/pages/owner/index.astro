---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import StatCard from "../components/StatCard.astro";
---

<DashboardLayout title="Overview" activeNav="overview">
  <PageHeader heading="Overview" sub="Ringkasan operasional FIREPRO" />

  <!-- Stat cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-8">
    <StatCard id="stat-clients-total" label="Total Klien" icon="users" accent />
    <StatCard id="stat-projects-active" label="Proyek Aktif" icon="folder" />
    <StatCard id="stat-invoices-pending" label="Invoice Pending" icon="invoice" />
    <StatCard id="stat-inventory-low" label="Stok Menipis" icon="box" />
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 mb-6">
    <!-- Proyek terbaru -->
    <div class="panel">
      <div class="flex items-center justify-between px-5 py-4 border-b-2 border-ink">
        <div>
          <h3 class="font-display text-lg text-ink leading-none">Proyek Terbaru</h3>
          <p class="font-mono text-[9px] text-steel uppercase tracking-widest mt-1">5 proyek terakhir dibuat</p>
        </div>
        <a href="/projects" class="font-mono text-[10px] text-steel border border-hairline px-2 py-1 hover:text-ink hover:border-ink transition-colors">Lihat Semua</a>
      </div>

      <!-- Skeleton (tampil saat memuat) -->
      <div id="overview-projects-skeleton">
        {Array.from({ length: 4 }).map(() => (
          <div class="skeleton-row">
            <div class="skeleton w-9 h-9 shrink-0"></div>
            <div class="flex-1 space-y-2">
              <div class="skeleton h-3 w-2/5"></div>
              <div class="skeleton h-2.5 w-1/4"></div>
            </div>
            <div class="skeleton h-5 w-14 shrink-0"></div>
          </div>
        ))}
      </div>

      <div id="overview-projects-empty" class="empty-state min-h-52 hidden">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5.5 8H18.5L19.5 21H4.5L5.5 8Z"/>
          <path d="M8.5 8V6C8.5 4.067 9.567 3 12 3C14.433 3 15.5 4.067 15.5 6V8"/>
        </svg>
        <p>Belum ada proyek</p>
      </div>

      <div id="overview-projects-list" class="hidden divide-y divide-hairline"></div>
    </div>

    <!-- Invoice terbaru -->
    <div class="panel">
      <div class="flex items-center justify-between px-5 py-4 border-b-2 border-ink">
        <div>
          <h3 class="font-display text-lg text-ink leading-none">Invoice Terbaru</h3>
          <p class="font-mono text-[9px] text-steel uppercase tracking-widest mt-1">5 invoice terakhir dibuat</p>
        </div>
        <a href="/invoices" class="font-mono text-[10px] text-steel border border-hairline px-2 py-1 hover:text-ink hover:border-ink transition-colors">Lihat Semua</a>
      </div>

      <div id="overview-invoices-skeleton">
        {Array.from({ length: 4 }).map(() => (
          <div class="skeleton-row">
            <div class="skeleton w-9 h-9 shrink-0"></div>
            <div class="flex-1 space-y-2">
              <div class="skeleton h-3 w-2/5"></div>
              <div class="skeleton h-2.5 w-1/4"></div>
            </div>
            <div class="skeleton h-5 w-14 shrink-0"></div>
          </div>
        ))}
      </div>

      <div id="overview-invoices-empty" class="empty-state min-h-52 hidden">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/>
        </svg>
        <p>Belum ada invoice</p>
      </div>

      <div id="overview-invoices-list" class="hidden divide-y divide-hairline"></div>
    </div>
  </div>

  <!-- Stok menipis -->
  <div class="panel">
    <div class="flex items-center justify-between px-5 py-4 border-b-2 border-ink">
      <div>
        <h3 class="font-display text-lg text-ink leading-none">Stok Menipis</h3>
        <p class="font-mono text-[9px] text-steel uppercase tracking-widest mt-1">Item inventory di bawah batas minimum</p>
      </div>
      <a href="/inventory" class="font-mono text-[10px] text-steel border border-hairline px-2 py-1 hover:text-ink hover:border-ink transition-colors">Lihat Inventory</a>
    </div>

    <div id="overview-inventory-skeleton">
      {Array.from({ length: 3 }).map(() => (
        <div class="skeleton-row">
          <div class="skeleton w-9 h-9 shrink-0"></div>
          <div class="flex-1 space-y-2">
            <div class="skeleton h-3 w-1/3"></div>
            <div class="skeleton h-2.5 w-1/5"></div>
          </div>
          <div class="skeleton h-5 w-10 shrink-0"></div>
        </div>
      ))}
    </div>

    <div id="overview-inventory-empty" class="empty-state min-h-44 hidden">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>
      </svg>
      <p>Tidak ada item dengan stok menipis</p>
    </div>

    <div id="overview-inventory-list" class="hidden divide-y divide-hairline"></div>
  </div>
</DashboardLayout>

<script>
  import { adminApiFetch, API_URL } from "../lib/auth";

  function setStat(id: string, value: string): void {
    const el = document.getElementById(id);
    const valueEl = el?.querySelector(".stat-value");
    if (valueEl) {
      valueEl.textContent = value;
      return;
    }
    // StatCard belum punya .stat-value (masih skeleton) — render manual
    if (el) {
      const label = el.querySelector("p");
      el.innerHTML = "";
      if (label) el.appendChild(label);
      const p = document.createElement("p");
      p.className = "stat-value font-display text-3xl sm:text-4xl leading-none text-ink";
      p.textContent = value;
      el.appendChild(p);
    }
  }

  // Menampilkan hasil (list atau empty state) dan menyembunyikan skeleton untuk satu section
  function resolveSection(prefix: string, hasData: boolean): void {
    document.getElementById(`${prefix}-skeleton`)?.classList.add("hidden");
    if (hasData) {
      document.getElementById(`${prefix}-list`)?.classList.remove("hidden");
    } else {
      document.getElementById(`${prefix}-empty`)?.classList.remove("hidden");
    }
  }

  function renderRow(opts: { title: string; sub: string; badge: string; badgeClass: string }): string {
    return `
      <div class="flex items-center gap-3 px-5 py-3.5">
        <div class="min-w-0 flex-1">
          <p class="text-sm font-semibold text-ink truncate">${opts.title}</p>
          <p class="font-mono text-[10px] text-smoke uppercase tracking-wide mt-0.5">${opts.sub}</p>
        </div>
        <span class="badge ${opts.badgeClass} shrink-0">${opts.badge}</span>
      </div>
    `;
  }

  async function loadOverview(): Promise<void> {
    try {
      const [clientsRes, projectsRes, invoicesRes, inventoryRes] = await Promise.allSettled([
        adminApiFetch(`${API_URL}/api/clients`),
        adminApiFetch(`${API_URL}/api/projects/admin`),
        adminApiFetch(`${API_URL}/api/invoices/admin`),
        adminApiFetch(`${API_URL}/api/inventory/admin`),
      ]);

      if (clientsRes.status === "fulfilled" && clientsRes.value.ok) {
        const json = await clientsRes.value.json();
        setStat("stat-clients-total", String(json.meta?.total ?? json.data?.length ?? 0));
      }

      if (projectsRes.status === "fulfilled" && projectsRes.value.ok) {
        const json = await projectsRes.value.json();
        const list = Array.isArray(json.data) ? json.data : [];
        const activeCount = list.filter((p: { status?: string }) => p.status === "ongoing" || p.status === "active").length;
        setStat("stat-projects-active", String(activeCount || json.meta?.total || 0));

        const recent = list.slice(0, 5);
        const listEl = document.getElementById("overview-projects-list");
        if (listEl && recent.length) {
          listEl.innerHTML = recent
            .map((p: { name?: string; clientName?: string; status?: string }) =>
              renderRow({
                title: p.name ?? "Proyek",
                sub: p.clientName ?? "—",
                badge: p.status ?? "-",
                badgeClass: p.status === "ongoing" || p.status === "active" ? "badge-active" : "badge-inactive",
              })
            )
            .join("");
        }
        resolveSection("overview-projects", recent.length > 0);
      } else {
        resolveSection("overview-projects", false);
      }

      if (invoicesRes.status === "fulfilled" && invoicesRes.value.ok) {
        const json = await invoicesRes.value.json();
        const list = Array.isArray(json.data) ? json.data : [];
        const pendingCount = list.filter((i: { status?: string }) => i.status === "unpaid" || i.status === "pending").length;
        setStat("stat-invoices-pending", String(pendingCount || json.meta?.total || 0));

        const recent = list.slice(0, 5);
        const listEl = document.getElementById("overview-invoices-list");
        if (listEl && recent.length) {
          listEl.innerHTML = recent
            .map((i: { invoiceNumber?: string; number?: string; total?: number; status?: string }) =>
              renderRow({
                title: i.invoiceNumber ?? i.number ?? "Invoice",
                sub: i.total ? `Rp ${Number(i.total).toLocaleString("id-ID")}` : "—",
                badge: i.status ?? "-",
                badgeClass: i.status === "paid" || i.status === "lunas" ? "badge-active" : "badge-warn",
              })
            )
            .join("");
        }
        resolveSection("overview-invoices", recent.length > 0);
      } else {
        resolveSection("overview-invoices", false);
      }

      if (inventoryRes.status === "fulfilled" && inventoryRes.value.ok) {
        const json = await inventoryRes.value.json();
        const list = Array.isArray(json.data) ? json.data : [];
        const lowStock = list.filter((it: { stock?: number; minStock?: number }) => (it.stock ?? 0) <= (it.minStock ?? 0));
        setStat("stat-inventory-low", String(lowStock.length));

        const listEl = document.getElementById("overview-inventory-list");
        if (listEl && lowStock.length) {
          listEl.innerHTML = lowStock
            .slice(0, 5)
            .map((it: { name?: string; stock?: number; unit?: string }) =>
              renderRow({
                title: it.name ?? "Item",
                sub: it.unit ?? "-",
                badge: `${it.stock ?? 0} tersisa`,
                badgeClass: "badge-warn",
              })
            )
            .join("");
        }
        resolveSection("overview-inventory", lowStock.length > 0);
      } else {
        resolveSection("overview-inventory", false);
      }
    } catch {
      // Kalau API belum bisa diakses, biarkan skeleton diganti empty state supaya tidak menggantung
      resolveSection("overview-projects", false);
      resolveSection("overview-invoices", false);
      resolveSection("overview-inventory", false);
    }
  }

  loadOverview();
</script>
