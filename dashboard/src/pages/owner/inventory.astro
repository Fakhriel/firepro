---
import OwnerLayout from "../../layouts/OwnerLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
---

<OwnerLayout title="Inventory" activeNav="inventory">
  <PageHeader heading="Inventory" sub="Kelola material &amp; peralatan FIREPRO" crumbs={[{ label: "Gudang" }, { label: "Inventory" }]}>
    <button id="btn-export-pdf" type="button" class="btn-secondary text-xs gap-1.5">
      <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5" stroke="currentColor" stroke-width="1.75">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/>
        <line x1="9" y1="15" x2="15" y2="15"/>
      </svg>
      Export PDF
    </button>
    <button id="btn-add-item" type="button" class="btn-primary text-xs gap-1.5">
      <svg viewBox="0 0 24 24" fill="none" class="w-3.5 h-3.5" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      Tambah Barang
    </button>
  </PageHeader>

  <!-- Filter bar -->
  <div class="flex flex-col sm:flex-row gap-3 mb-5">
    <input
      id="search-item"
      type="search"
      placeholder="Cari nama barang…"
      class="field-input sm:max-w-xs"
    />
    <select id="filter-category" class="field-input sm:w-44">
      <option value="">Semua Kategori</option>
      <option value="fire_alarm">Fire Alarm</option>
      <option value="hydrant">Hydrant</option>
      <option value="apar">APAR</option>
      <option value="sprinkler">Sprinkler</option>
      <option value="electrical">Elektrikal</option>
      <option value="cable">Kabel</option>
      <option value="tools">Peralatan</option>
      <option value="other">Lainnya</option>
    </select>
    <select id="filter-status" class="field-input sm:w-36">
      <option value="">Semua Status</option>
      <option value="active">Aktif</option>
      <option value="inactive">Nonaktif</option>
    </select>
  </div>

  <!-- Table -->
  <div class="panel overflow-hidden">
    <div class="overflow-x-auto">
      <table id="inventory-table" class="data-table hidden">
        <thead>
          <tr>
            <th class="w-10">#</th>
            <th>Barang</th>
            <th class="hidden sm:table-cell">Kode</th>
            <th>Harga Satuan</th>
            <th class="hidden md:table-cell">Kategori</th>
            <th class="hidden md:table-cell">Stok</th>
            <th>Status</th>
            <th class="text-right">Aksi</th>
          </tr>
        </thead>
        <tbody id="inventory-body">
          <!-- Diisi via JS setelah konek backend -->
        </tbody>
      </table>
    </div>

    <!-- Empty state -->
    <div id="inventory-skeleton">
      {Array.from({ length: 6 }).map(() => (
        <div class="skeleton-row">
          <div class="skeleton w-9 h-9 shrink-0"></div>
          <div class="flex-1 space-y-2">
            <div class="skeleton h-3 w-1/3"></div>
            <div class="skeleton h-2.5 w-1/5"></div>
          </div>
          <div class="skeleton h-5 w-16 shrink-0"></div>
        </div>
      ))}
    </div>
    <div id="inventory-empty" class="empty-state min-h-56 hidden">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>
      </svg>
      <p>Belum ada barang — tambahkan barang pertama</p>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between px-4 py-3 border-t border-hairline">
      <span id="inventory-count" class="font-mono text-[10px] text-smoke">0 barang</span>
      <div class="flex items-center gap-1">
        <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" disabled>←</button>
        <span class="font-mono text-xs px-3 py-1.5 border border-hairline">1</span>
        <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" disabled>→</button>
      </div>
    </div>
  </div>

  <!-- Modal: Tambah / Edit Barang -->
  <div id="item-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-ink/50">
    <div class="bg-surface border-2 border-ink w-full max-w-lg max-h-[90vh] overflow-y-auto brutal-shadow">
      <div class="flex items-center justify-between px-5 py-4 border-b-2 border-ink sticky top-0 bg-surface">
        <h2 id="modal-title" class="font-display text-xl text-ink">Tambah Barang</h2>
        <button id="modal-close" type="button" class="text-steel hover:text-ink transition-colors p-1">
          <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <div class="p-5 space-y-4">
        <input type="hidden" id="item-id" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label class="field-label" for="item-name">Nama Barang</label>
            <input id="item-name" type="text" placeholder="Semen Portland 50kg" class="field-input" />
          </div>
          <div>
            <label class="field-label" for="item-category">Kategori</label>
            <select id="item-category" class="field-input">
              <option value="fire_alarm">Fire Alarm</option>
              <option value="hydrant">Hydrant</option>
              <option value="apar">APAR</option>
              <option value="sprinkler">Sprinkler</option>
              <option value="electrical">Elektrikal</option>
              <option value="cable">Kabel</option>
              <option value="tools">Peralatan</option>
              <option value="other">Lainnya</option>
            </select>
          </div>
          <div>
            <label class="field-label" for="item-price">Harga Satuan (Rp)</label>
            <input id="item-price" type="text" inputmode="numeric" placeholder="Rp 0" class="field-input" />
          </div>
          <div class="sm:col-span-2">
            <label class="field-label" for="item-desc">Deskripsi</label>
            <textarea id="item-desc" rows="3" placeholder="Deskripsi singkat barang…" class="field-input resize-none"></textarea>
          </div>

          <!-- Foto barang: drag & drop upload, foto pertama jadi cover -->
          <div class="sm:col-span-2">
            <label class="field-label">Foto Barang</label>
            <div id="image-dropzone" class="border-2 border-dashed border-hairline hover:border-signal transition-colors px-4 py-6 text-center cursor-pointer">
              <input id="image-file-input" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple class="hidden" />
              <svg viewBox="0 0 24 24" fill="none" class="w-6 h-6 mx-auto mb-2 text-smoke" stroke="currentColor" stroke-width="1.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
              <p class="font-mono text-xs text-charcoal">Tarik & lepas foto ke sini, atau klik untuk pilih file</p>
              <p class="font-mono text-[9px] text-smoke mt-1">JPG, PNG, atau WEBP — foto pertama jadi foto sampul (cover)</p>
            </div>
            <div id="image-previews" class="grid grid-cols-4 gap-2 mt-3"></div>
          </div>

          <!-- Stok awal: cuma berlaku saat barang pertama dibuat.
               Backend belum mendukung ubah stok lewat form edit — stok
               setelahnya harus lewat pencatatan mutasi stok (in/out). -->
          <div class="sm:col-span-2">
            <label class="field-label" for="item-initial-stock">Stok Awal</label>
            <input id="item-initial-stock" type="number" min="0" step="1" placeholder="0" class="field-input" />
            <p id="item-initial-stock-note" class="font-mono text-[9px] text-smoke mt-1 hidden">
              Stok cuma bisa diatur saat barang pertama dibuat. Untuk barang yang sudah ada, penyesuaian stok butuh fitur pencatatan mutasi stok terpisah.
            </p>
          </div>

          <div class="sm:col-span-2">
            <label class="field-label" for="item-status">Status</label>
            <select id="item-status" class="field-input">
              <option value="active">Aktif</option>
              <option value="inactive">Nonaktif</option>
            </select>
          </div>
        </div>

        <!-- Error inline form -->
        <div id="item-form-error" class="hidden border-2 border-signal bg-signal-dim px-3 py-2.5">
          <p class="font-mono text-xs text-signal" id="item-form-error-msg"></p>
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-hairline">
        <button id="modal-cancel" type="button" class="btn-secondary text-sm">Batal</button>
        <button id="modal-save" type="button" class="btn-primary text-sm">Simpan</button>
      </div>
    </div>
  </div>

  <!-- Modal: Konfirmasi Hapus -->
  <div id="delete-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-ink/50">
    <div class="bg-surface border-2 border-ink w-full max-w-sm brutal-shadow">
      <div class="px-5 py-4 border-b-2 border-ink">
        <h2 class="font-display text-xl text-ink">Hapus Barang?</h2>
      </div>
      <div class="px-5 py-4">
        <p class="font-body text-sm text-charcoal">Barang <strong id="delete-item-name" class="text-ink"></strong> akan dihapus permanen. Tindakan ini tidak bisa dibatalkan.</p>
      </div>
      <div class="flex gap-3 px-5 py-4 border-t border-hairline">
        <button id="delete-cancel" type="button" class="btn-secondary text-sm flex-1">Batal</button>
        <button id="delete-confirm" type="button" class="btn-danger text-sm flex-1">Hapus</button>
      </div>
    </div>
  </div>

  <!-- Purchase requests needing approval -->
  <div class="panel overflow-hidden mt-8">
    <div class="px-5 py-4 border-b-2 border-ink">
      <h3 class="font-display text-lg text-ink leading-none">Permintaan Pembelian Barang</h3>
      <p class="font-mono text-[9px] text-smoke uppercase tracking-widest mt-1">Diajukan oleh supervisor / teknisi lapangan</p>
    </div>
    <div class="overflow-x-auto">
      <table id="purchase-table" class="data-table hidden">
        <thead>
          <tr>
            <th>Alat / Material</th>
            <th class="hidden sm:table-cell">Jumlah</th>
            <th class="hidden sm:table-cell">Diajukan Oleh</th>
            <th class="hidden md:table-cell">Tanggal</th>
            <th>Status</th>
            <th class="text-right">Aksi</th>
          </tr>
        </thead>
        <tbody id="purchase-body"></tbody>
      </table>
    </div>
    <div id="purchase-skeleton">
      {Array.from({ length: 4 }).map(() => (
        <div class="skeleton-row">
          <div class="skeleton w-9 h-9 shrink-0"></div>
          <div class="flex-1 space-y-2">
            <div class="skeleton h-3 w-1/3"></div>
            <div class="skeleton h-2.5 w-1/5"></div>
          </div>
          <div class="skeleton h-5 w-16 shrink-0"></div>
        </div>
      ))}
    </div>
    <div id="purchase-empty" class="empty-state min-h-52 hidden">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M20 6L9 17l-5-5"/>
      </svg>
      <p>Tidak ada permintaan pembelian yang menunggu</p>
    </div>
  </div>

  <!-- Approve/reject modal -->
  <div id="purchase-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/50 p-4">
    <div class="panel w-full max-w-sm bg-surface">
      <div class="flex items-center justify-between px-5 py-4 border-b-2 border-ink">
        <h3 class="font-display text-lg text-ink leading-none">Tinjau Permintaan</h3>
        <button id="purchase-modal-close" type="button" class="text-steel hover:text-ink transition-colors" aria-label="Tutup">
          <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5" stroke="currentColor" stroke-width="1.75">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="p-5">
        <p class="font-body text-sm text-charcoal">
          <span id="purchase-modal-item" class="font-semibold text-ink"></span> —
          qty <span id="purchase-modal-qty"></span>, diajukan oleh
          <span id="purchase-modal-by"></span>.
        </p>
      </div>
      <div class="flex items-center justify-end gap-2 px-5 py-4 border-t border-hairline">
        <button id="btn-reject-purchase" type="button" class="btn-danger text-xs">Tolak</button>
        <button id="btn-approve-purchase" type="button" class="btn-primary text-xs" style="background-color: var(--color-armed, #1f7a4d); border-color: var(--color-armed, #1f7a4d);">Setujui</button>
      </div>
    </div>
  </div>
</OwnerLayout>

<script>
  import { exportTableToPDF } from "../../lib/export";
  import { adminApiFetch } from "../../lib/auth";
  import { escapeHtml } from "../../lib/escapeHtml";
  import { attachRupiahFormatting, setRupiahValue, getRupiahValue } from "../../lib/rupiahInput";
  import { resolveUploadUrl } from "../../lib/resolveUploadUrl";

  const apiUrl =
    document.getElementById("dashboard-root")?.dataset.apiUrl || "http://localhost:4000";

  interface AdminInventoryItem {
    id: string;
    code: string;
    name: string;
    category: string;
    purchasePrice: number | null;
    isActive: number | boolean;
    coverImage: string | null;
    stock: number;
  }

  interface InventoryItemDetail extends AdminInventoryItem {
    description: string;
    images: string[];
  }

  let allItems: AdminInventoryItem[] = [];
  let itemBeingDeleted: { id: string; name: string } | null = null;

  const tableBody = document.getElementById("inventory-body") as HTMLTableSectionElement;
  const emptyState = document.getElementById("inventory-empty") as HTMLDivElement;
  const countLabel = document.getElementById("inventory-count") as HTMLSpanElement;
  const table = document.getElementById("inventory-table") as HTMLTableElement;
  const skeletonEl_inventory = document.getElementById("inventory-skeleton") as HTMLDivElement;

  function formatRupiah(value: number): string {
    return new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", minimumFractionDigits: 0 }).format(value);
  }

  const CATEGORY_LABEL: Record<string, string> = {
    fire_alarm: "Fire Alarm",
    hydrant: "Hydrant",
    apar: "APAR",
    sprinkler: "Sprinkler",
    electrical: "Elektrikal",
    cable: "Kabel",
    tools: "Peralatan",
    other: "Lainnya",
  };

  // ─── Render tabel ───────────────────────────────────────────────
  function renderTable(items: AdminInventoryItem[]): void {
    tableBody.innerHTML = "";

    const isEmpty = items.length === 0;
    skeletonEl_inventory.classList.add("hidden");
    table.classList.toggle("hidden", isEmpty);
    emptyState.classList.toggle("hidden", !isEmpty);
    countLabel.textContent = `${items.length} barang`;

    items.forEach((it, index) => {
      const isActive = Boolean(it.isActive);
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td class="font-mono text-xs text-smoke">${index + 1}</td>
        <td>
          <div class="flex items-center gap-2.5">
            <img src="${escapeHtml(resolveUploadUrl(it.coverImage) || "/favicon.svg")}" alt="${escapeHtml(it.name)}" class="w-9 h-9 object-cover border border-hairline shrink-0" />
            <div class="min-w-0">
              <p class="font-semibold text-ink truncate">${escapeHtml(it.name)}</p>
              <p class="font-mono text-[10px] text-smoke truncate">${escapeHtml(CATEGORY_LABEL[it.category] ?? it.category)}</p>
            </div>
          </div>
        </td>
        <td class="hidden sm:table-cell font-mono text-xs text-smoke">${escapeHtml(it.code)}</td>
        <td class="font-mono text-xs">${it.purchasePrice != null ? formatRupiah(it.purchasePrice) : "-"}</td>
        <td class="hidden md:table-cell text-xs">${escapeHtml(CATEGORY_LABEL[it.category] ?? it.category)}</td>
        <td class="hidden md:table-cell font-mono text-xs">${Number(it.stock)}</td>
        <td>
          <span class="px-2 py-0.5 text-[10px] font-mono uppercase tracking-wide border ${isActive ? "border-ink text-ink" : "border-smoke text-smoke"}">
            ${isActive ? "Aktif" : "Nonaktif"}
          </span>
        </td>
        <td class="text-right whitespace-nowrap">
          <button type="button" class="btn-edit-item text-xs px-2 py-1 hover:underline" data-id="${it.id}">Edit</button>
          <button type="button" class="btn-delete-item text-xs px-2 py-1 text-signal hover:underline" data-id="${it.id}" data-name="${escapeHtml(it.name)}">Hapus</button>
        </td>
      `;
      tableBody.appendChild(tr);
    });

    table.querySelectorAll<HTMLButtonElement>(".btn-edit-item").forEach((btn) => {
      btn.addEventListener("click", () => openEditModal(btn.dataset.id!));
    });
    table.querySelectorAll<HTMLButtonElement>(".btn-delete-item").forEach((btn) => {
      btn.addEventListener("click", () => {
        itemBeingDeleted = { id: btn.dataset.id!, name: btn.dataset.name! };
        (document.getElementById("delete-item-name") as HTMLElement).textContent = itemBeingDeleted.name;
        openModal("delete-modal");
      });
    });
  }

  function applyFilters(): void {
    const keyword = (document.getElementById("search-item") as HTMLInputElement).value.trim().toLowerCase();
    const category = (document.getElementById("filter-category") as HTMLSelectElement).value;
    const status = (document.getElementById("filter-status") as HTMLSelectElement).value;

    const filtered = allItems.filter((it) => {
      if (keyword && !it.name.toLowerCase().includes(keyword)) return false;
      if (category && it.category !== category) return false;
      if (status === "active" && !it.isActive) return false;
      if (status === "inactive" && it.isActive) return false;
      return true;
    });

    renderTable(filtered);
  }

  async function loadInventory(): Promise<void> {
    try {
      const res = await adminApiFetch(`${apiUrl}/api/owner/inventory/admin`);
      const json = await res.json();
      if (!res.ok) {
        window.showToast?.(json.error ?? "Gagal memuat inventory", "error");
        return;
      }
      allItems = json.data ?? [];
      applyFilters();
    } catch (err) {
      console.error("[loadInventory] gagal fetch backend:", err);
      window.showToast?.("Tidak bisa terhubung ke server", "error");
    }
  }

  document.getElementById("search-item")?.addEventListener("input", applyFilters);
  document.getElementById("filter-category")?.addEventListener("change", applyFilters);
  document.getElementById("filter-status")?.addEventListener("change", applyFilters);

  // ─── Modal helpers ────────────────────────────────────────────────
  function openModal(id: string): void {
    const el = document.getElementById(id);
    el?.classList.remove("hidden");
    el?.classList.add("flex");
  }
  function closeModal(id: string): void {
    const el = document.getElementById(id);
    el?.classList.add("hidden");
    el?.classList.remove("flex");
  }

  // ─── Baris dinamis: Varian & Stok ──────────────────────────────────
  // ─── Foto: drag & drop upload ─────────────────────────────────────
  const dropzone = document.getElementById("image-dropzone") as HTMLDivElement;
  const fileInput = document.getElementById("image-file-input") as HTMLInputElement;
  const previewsContainer = document.getElementById("image-previews") as HTMLDivElement;
  let uploadedImages: string[] = [];

  function renderPreviews(): void {
    previewsContainer.innerHTML = uploadedImages
      .map(
        (url, i) => `
        <div class="relative group">
          <img src="${escapeHtml(resolveUploadUrl(url))}" class="w-full aspect-square object-cover border-2 ${i === 0 ? "border-signal" : "border-hairline"}" />
          ${i === 0 ? `<span class="absolute top-1 left-1 bg-signal text-paper font-mono text-[8px] px-1.5 py-0.5">COVER</span>` : ""}
          <button type="button" data-remove-image="${i}" class="absolute top-1 right-1 bg-ink/70 text-paper w-5 h-5 flex items-center justify-center text-xs opacity-0 group-hover:opacity-100 transition-opacity">×</button>
        </div>
      `
      )
      .join("");
    previewsContainer.querySelectorAll<HTMLButtonElement>("[data-remove-image]").forEach((btn) => {
      btn.addEventListener("click", () => {
        uploadedImages.splice(Number(btn.dataset.removeImage), 1);
        renderPreviews();
      });
    });
  }

  async function uploadImageFiles(files: FileList | File[]): Promise<void> {
    for (const file of Array.from(files)) {
      if (!file.type.startsWith("image/")) {
        window.showToast?.(`${file.name} bukan file gambar, dilewati`, "error");
        continue;
      }
      const formData = new FormData();
      formData.append("image", file);
      try {
        const res = await adminApiFetch(`${apiUrl}/api/owner/inventory/upload-image`, { method: "POST", body: formData });
        const json = await res.json();
        if (!res.ok) {
          window.showToast?.(json.error ?? `Gagal upload ${file.name}`, "error");
          continue;
        }
        uploadedImages.push(json.data.url);
      } catch (err) {
        console.error("[uploadImageFiles] gagal fetch backend:", err);
        window.showToast?.("Tidak bisa terhubung ke server", "error");
      }
    }
    renderPreviews();
  }

  dropzone?.addEventListener("click", () => fileInput.click());
  fileInput?.addEventListener("change", () => {
    if (fileInput.files?.length) uploadImageFiles(fileInput.files);
    fileInput.value = "";
  });
  dropzone?.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropzone.classList.add("border-signal");
  });
  dropzone?.addEventListener("dragleave", () => {
    dropzone.classList.remove("border-signal");
  });
  dropzone?.addEventListener("drop", (e) => {
    e.preventDefault();
    dropzone.classList.remove("border-signal");
    if (e.dataTransfer?.files?.length) uploadImageFiles(e.dataTransfer.files);
  });

  function getImagesFromForm(): string[] {
    return uploadedImages;
  }

  function resetImages(urls: string[] = []): void {
    uploadedImages = [...urls];
    renderPreviews();
  }

  // ─── Form error helper ──────────────────────────────────────────
  function showFormError(msg: string): void {
    const box = document.getElementById("item-form-error");
    const msgEl = document.getElementById("item-form-error-msg");
    if (msgEl) msgEl.textContent = msg;
    box?.classList.remove("hidden");
  }
  function hideFormError(): void {
    document.getElementById("item-form-error")?.classList.add("hidden");
  }

  function resetForm(): void {
    (document.getElementById("item-id") as HTMLInputElement).value = "";
    (document.getElementById("item-name") as HTMLInputElement).value = "";
    (document.getElementById("item-category") as HTMLSelectElement).value = "fire_alarm";
    setRupiahValue(document.getElementById("item-price") as HTMLInputElement, null);
    (document.getElementById("item-desc") as HTMLTextAreaElement).value = "";
    (document.getElementById("item-status") as HTMLSelectElement).value = "active";
    (document.getElementById("item-initial-stock") as HTMLInputElement).value = "";
    (document.getElementById("item-initial-stock") as HTMLInputElement).disabled = false;
    document.getElementById("item-initial-stock-note")?.classList.add("hidden");
    resetImages();
    hideFormError();
  }

  // ─── Tambah barang ──────────────────────────────────────────────
  document.getElementById("btn-add-item")?.addEventListener("click", () => {
    resetForm();
    (document.getElementById("modal-title") as HTMLElement).textContent = "Tambah Barang";
    (document.getElementById("modal-save") as HTMLButtonElement).textContent = "Simpan";
    openModal("item-modal");
  });

  // ─── Edit barang: ambil detail lengkap dari backend ───────────────
  async function openEditModal(id: string): Promise<void> {
    resetForm();
    try {
      const res = await adminApiFetch(`${apiUrl}/api/owner/inventory/${id}`);
      const json = await res.json();
      if (!res.ok) {
        window.showToast?.(json.error ?? "Gagal memuat detail barang", "error");
        return;
      }
      const item: InventoryItemDetail = json.data;

      (document.getElementById("item-id") as HTMLInputElement).value = item.id;
      (document.getElementById("item-name") as HTMLInputElement).value = item.name;
      (document.getElementById("item-category") as HTMLSelectElement).value = item.category;
      setRupiahValue(document.getElementById("item-price") as HTMLInputElement, item.purchasePrice);
      (document.getElementById("item-desc") as HTMLTextAreaElement).value = item.description;
      (document.getElementById("item-status") as HTMLSelectElement).value = item.isActive ? "active" : "inactive";

      resetImages(item.images);

      // Stok cuma bisa diatur saat barang pertama dibuat — tampilkan
      // stok saat ini sebagai info, tapi input dikunci saat edit.
      const stockInput = document.getElementById("item-initial-stock") as HTMLInputElement;
      stockInput.value = String(item.stock);
      stockInput.disabled = true;
      document.getElementById("item-initial-stock-note")?.classList.remove("hidden");

      (document.getElementById("modal-title") as HTMLElement).textContent = "Edit Barang";
      (document.getElementById("modal-save") as HTMLButtonElement).textContent = "Simpan Perubahan";
      openModal("item-modal");
    } catch (err) {
      console.error("[openEditModal] gagal fetch backend:", err);
      window.showToast?.("Tidak bisa terhubung ke server", "error");
    }
  }

  document.getElementById("modal-close")?.addEventListener("click", () => closeModal("item-modal"));
  document.getElementById("modal-cancel")?.addEventListener("click", () => closeModal("item-modal"));

  // ─── Submit Create / Update ───────────────────────────────────────
  document.getElementById("modal-save")?.addEventListener("click", async () => {
    hideFormError();

    const id = (document.getElementById("item-id") as HTMLInputElement).value;
    const name = (document.getElementById("item-name") as HTMLInputElement).value.trim();
    const category = (document.getElementById("item-category") as HTMLSelectElement).value;
    const price = getRupiahValue(document.getElementById("item-price") as HTMLInputElement);
    const description = (document.getElementById("item-desc") as HTMLTextAreaElement).value.trim();
    const isActive = (document.getElementById("item-status") as HTMLSelectElement).value === "active";
    const images = getImagesFromForm();
    const initialStock = (document.getElementById("item-initial-stock") as HTMLInputElement).value;

    // Validasi dasar di client — validasi penuh & otoritatif tetap di
    // backend (lihat validateInput di inventory.service.js), ini cuma
    // supaya tidak perlu menunggu round-trip network untuk kesalahan
    // yang jelas-jelas terlihat dari form.
    if (!name || !category || !description) {
      showFormError("Nama, kategori, dan deskripsi wajib diisi.");
      return;
    }
    if (images.length === 0) {
      showFormError("Minimal 1 foto wajib diupload.");
      return;
    }

    const payload: Record<string, unknown> = {
      name,
      category,
      purchasePrice: price || null,
      description,
      isActive,
      images,
    };
    // initialStock cuma dikirim & berlaku saat barang BARU dibuat —
    // backend tidak menerima ini saat update (lihat inventory.service.js).
    if (!id && initialStock) {
      payload.initialStock = Number(initialStock);
    }

    const saveBtn = document.getElementById("modal-save") as HTMLButtonElement;
    const originalLabel = saveBtn.textContent;
    saveBtn.disabled = true;
    saveBtn.textContent = "Menyimpan…";

    try {
      const res = await adminApiFetch(
        id ? `${apiUrl}/api/owner/inventory/${id}` : `${apiUrl}/api/owner/inventory`,
        {
          method: id ? "PATCH" : "POST",
          body: JSON.stringify(payload),
        }
      );
      const json = await res.json();

      if (!res.ok) {
        showFormError(json.error ?? "Gagal menyimpan barang.");
        return;
      }

      window.showToast?.(json.message ?? "Barang berhasil disimpan");
      closeModal("item-modal");
      await loadInventory();
    } catch (err) {
      console.error("[modal-save] gagal fetch backend:", err);
      showFormError("Tidak bisa terhubung ke server. Coba lagi.");
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = originalLabel;
    }
  });

  // ─── Delete ────────────────────────────────────────────────────
  document.getElementById("delete-cancel")?.addEventListener("click", () => {
    itemBeingDeleted = null;
    closeModal("delete-modal");
  });

  document.getElementById("delete-confirm")?.addEventListener("click", async () => {
    if (!itemBeingDeleted) return;

    const confirmBtn = document.getElementById("delete-confirm") as HTMLButtonElement;
    const originalLabel = confirmBtn.textContent;
    confirmBtn.disabled = true;
    confirmBtn.textContent = "Menghapus…";

    try {
      const res = await adminApiFetch(`${apiUrl}/api/owner/inventory/${itemBeingDeleted.id}`, {
        method: "DELETE",
      });
      const json = await res.json();

      if (!res.ok) {
        window.showToast?.(json.error ?? "Gagal menghapus barang", "error");
        return;
      }

      window.showToast?.(json.message ?? "Barang dihapus");
      closeModal("delete-modal");
      await loadInventory();
    } catch (err) {
      console.error("[delete-confirm] gagal fetch backend:", err);
      window.showToast?.("Tidak bisa terhubung ke server", "error");
    } finally {
      itemBeingDeleted = null;
      confirmBtn.disabled = false;
      confirmBtn.textContent = originalLabel;
    }
  });

  // ─── Export PDF ────────────────────────────────────────────────
  document.getElementById("btn-export-pdf")?.addEventListener("click", () => {
    exportTableToPDF("inventory-table", {
      title: "Daftar Inventory",
      subtitle: "Katalog barang FIREPRO",
    });
  });

  // ─── Init ──────────────────────────────────────────────────────
  // ─── Purchase requests (khusus Owner) ─────────────────────────────
  interface PurchaseRequest {
    id: number;
    itemName?: string;
    name?: string;
    quantity?: number;
    requestedByName?: string;
    requesterName?: string;
    createdAt?: string;
    status: string;
  }

  let purchaseRequestBeingReviewed: PurchaseRequest | null = null;

  const purchaseBody = document.getElementById("purchase-body") as HTMLTableSectionElement | null;
  const purchaseTable = document.getElementById("purchase-table") as HTMLTableElement | null;
  const purchaseEmpty = document.getElementById("purchase-empty") as HTMLDivElement | null;
  const skeletonEl_purchase = document.getElementById("purchase-skeleton") as HTMLDivElement;

  function formatDatePR(iso?: string): string {
    if (!iso) return "-";
    try {
      return new Date(iso).toLocaleDateString("id-ID", { day: "2-digit", month: "short", year: "numeric" });
    } catch {
      return "-";
    }
  }

  function renderPurchaseRequests(requests: PurchaseRequest[]): void {
    if (!purchaseBody || !purchaseTable || !purchaseEmpty) return;
    purchaseBody.innerHTML = "";
    const isEmpty = requests.length === 0;
    skeletonEl_purchase.classList.add("hidden");
    purchaseTable.classList.toggle("hidden", isEmpty);
    purchaseEmpty.classList.toggle("hidden", !isEmpty);

    requests.forEach((r) => {
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td class="font-semibold text-ink">${escapeHtml(r.itemName ?? r.name ?? "-")}</td>
        <td class="hidden sm:table-cell font-mono text-xs text-charcoal">${r.quantity ?? "-"}</td>
        <td class="hidden sm:table-cell font-mono text-xs text-charcoal">${escapeHtml(r.requestedByName ?? r.requesterName ?? "-")}</td>
        <td class="hidden md:table-cell font-mono text-xs text-charcoal">${formatDatePR(r.createdAt)}</td>
        <td><span class="font-mono text-[9px] uppercase tracking-widest border border-signal text-signal px-2 py-1">Menunggu</span></td>
        <td class="text-right">
          <button type="button" data-id="${r.id}" class="btn-review-purchase text-xs text-steel hover:text-ink font-mono underline-offset-2 hover:underline">Tinjau</button>
        </td>
      `;
      purchaseBody.appendChild(tr);
    });

    purchaseBody.querySelectorAll<HTMLButtonElement>(".btn-review-purchase").forEach((btn) => {
      btn.addEventListener("click", () => {
        const req = allPurchaseRequests.find((r) => String(r.id) === btn.dataset.id);
        if (req) openPurchaseModal(req);
      });
    });
  }

  let allPurchaseRequests: PurchaseRequest[] = [];

  async function loadPurchaseRequests(): Promise<void> {
    try {
      const res = await adminApiFetch(`${apiUrl}/api/owner/inventory/requests?status=pending`);
      const json = await res.json();
      if (!res.ok) {
        window.showToast?.(json.error ?? "Gagal memuat permintaan pembelian", "error");
        return;
      }
      allPurchaseRequests = json.data ?? [];
      renderPurchaseRequests(allPurchaseRequests);
    } catch (err) {
      console.error("[loadPurchaseRequests] gagal fetch backend:", err);
      window.showToast?.("Tidak bisa terhubung ke server", "error");
    }
  }

  function openPurchaseModal(req: PurchaseRequest): void {
    purchaseRequestBeingReviewed = req;
    (document.getElementById("purchase-modal-item") as HTMLElement).textContent = req.itemName ?? req.name ?? "-";
    (document.getElementById("purchase-modal-qty") as HTMLElement).textContent = String(req.quantity ?? "-");
    (document.getElementById("purchase-modal-by") as HTMLElement).textContent = req.requestedByName ?? req.requesterName ?? "-";
    openModal("purchase-modal");
  }
  document.getElementById("purchase-modal-close")?.addEventListener("click", () => closeModal("purchase-modal"));

  async function reviewPurchase(action: "approve" | "reject"): Promise<void> {
    if (!purchaseRequestBeingReviewed) return;
    try {
      const res = await adminApiFetch(`${apiUrl}/api/owner/inventory/requests/${purchaseRequestBeingReviewed.id}/${action}`, {
        method: "PATCH",
      });
      const json = await res.json();
      if (!res.ok) {
        window.showToast?.(json.error ?? "Gagal memproses permintaan", "error");
        return;
      }
      window.showToast?.(json.message ?? "Permintaan berhasil diproses");
      closeModal("purchase-modal");
      purchaseRequestBeingReviewed = null;
      await loadPurchaseRequests();
    } catch (err) {
      console.error("[reviewPurchase] gagal fetch backend:", err);
      window.showToast?.("Tidak bisa terhubung ke server", "error");
    }
  }

  document.getElementById("btn-approve-purchase")?.addEventListener("click", () => reviewPurchase("approve"));
  document.getElementById("btn-reject-purchase")?.addEventListener("click", () => reviewPurchase("reject"));

  loadPurchaseRequests();

  attachRupiahFormatting(document.getElementById("item-price") as HTMLInputElement);
  loadInventory();
</script>
