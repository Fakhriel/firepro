---
import OwnerLayout from "../../layouts/OwnerLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
---

<OwnerLayout title="Settings" activeNav="settings">
  <PageHeader heading="Settings" sub="Profil akun dan kebijakan penggunaan" crumbs={[{ label: "Sistem" }, { label: "Settings" }]} />

  <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 sm:gap-6">
    <div class="lg:col-span-1">
      <nav class="panel p-2 space-y-1">
        <button type="button" data-settings-tab="account" class="settings-tab active w-full text-left px-3 py-2 font-body text-sm font-semibold rounded-sm">Profil</button>
        <button type="button" data-settings-tab="terms" class="settings-tab w-full text-left px-3 py-2 font-body text-sm text-charcoal rounded-sm">Terms & Policy</button>
      </nav>
    </div>

    <div class="lg:col-span-4 space-y-4 sm:space-y-6">

      <form id="panel-account" class="settings-panel panel">
        <div class="px-5 py-4 border-b-2 border-ink">
          <h3 class="font-display text-lg text-ink leading-none">Profil</h3>
          <p class="font-mono text-[9px] text-smoke uppercase tracking-widest mt-1">Informasi akun Owner</p>
        </div>
        <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="field-label" for="acc-name">Nama Lengkap</label>
            <input id="acc-name" type="text" class="field-input" placeholder="Nama lengkap" />
          </div>
          <div>
            <label class="field-label" for="acc-email">Email</label>
            <input id="acc-email" type="email" class="field-input" placeholder="owner@firepro.id" />
          </div>
          <div>
            <label class="field-label" for="acc-phone">No. Telepon</label>
            <input id="acc-phone" type="tel" class="field-input" placeholder="08xx-xxxx-xxxx" />
          </div>
          <div>
            <label class="field-label" for="acc-current-password">Password Saat Ini <span class="text-smoke normal-case">— isi hanya jika ganti password</span></label>
            <input id="acc-current-password" type="password" class="field-input" placeholder="••••••••" autocomplete="current-password" />
          </div>
          <div>
            <label class="field-label" for="acc-password">Password Baru</label>
            <input id="acc-password" type="password" class="field-input" placeholder="Min. 6 karakter" autocomplete="new-password" />
          </div>
        </div>
        <div id="panel-account-error" class="hidden mx-5 mb-4 border-2 border-signal bg-signal-dim px-3 py-2">
          <p id="panel-account-error-msg" class="font-mono text-xs text-signal"></p>
        </div>
        <div class="flex items-center justify-end gap-2 px-5 py-4 border-t border-hairline">
          <button type="reset" class="btn-secondary text-xs">Batal</button>
          <button type="submit" class="btn-primary text-xs">Simpan Perubahan</button>
        </div>
      </form>

      <div id="panel-terms" class="settings-panel panel hidden">
        <div class="px-5 py-4 border-b-2 border-ink">
          <h3 class="font-display text-lg text-ink leading-none">Terms & Policy</h3>
          <p class="font-mono text-[9px] text-smoke uppercase tracking-widest mt-1">Ketentuan penggunaan sistem FIREPRO</p>
        </div>
        <div class="p-5 space-y-4 text-sm text-charcoal leading-relaxed">
          <div>
            <h4 class="font-semibold text-ink mb-1">Penggunaan Sistem</h4>
            <p>FIREPRO digunakan untuk mengelola operasional layanan proteksi kebakaran secara internal. Setiap akun hanya boleh digunakan oleh pemiliknya sendiri dan tidak boleh dibagikan ke pihak lain.</p>
          </div>
          <div>
            <h4 class="font-semibold text-ink mb-1">Kerahasiaan Data</h4>
            <p>Data klien, proyek, dan keuangan yang tersimpan di sistem ini bersifat rahasia dan hanya boleh diakses sesuai kewenangan role masing-masing pengguna.</p>
          </div>
          <div>
            <h4 class="font-semibold text-ink mb-1">Keamanan Akun</h4>
            <p>Pengguna bertanggung jawab menjaga kerahasiaan password akunnya. Segera ganti password dan laporkan ke Owner apabila mencurigai ada akses tidak sah ke akun Anda.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</OwnerLayout>

<style>
  .settings-tab.active {
    background-color: var(--color-ink);
    color: var(--color-paper);
  }
</style>

<script>
  import { adminApiFetch, getAdminAuth, setAdminAuth } from "../../lib/auth";

  const apiUrl =
    document.getElementById("dashboard-root")?.dataset.apiUrl || "http://localhost:4000";

  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-settings-tab]");
  const panels: Record<string, HTMLElement | null> = {
    account: document.getElementById("panel-account"),
    terms: document.getElementById("panel-terms"),
  };

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const key = tab.dataset.settingsTab ?? "account";
      tabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      Object.entries(panels).forEach(([k, el]) => {
        el?.classList.toggle("hidden", k !== key);
      });
    });
  });

  const { admin: currentAdmin, token: currentToken } = getAdminAuth();
  const nameInput = document.getElementById("acc-name") as HTMLInputElement;
  const emailInput = document.getElementById("acc-email") as HTMLInputElement;
  const phoneInput = document.getElementById("acc-phone") as HTMLInputElement;
  const currentPasswordInput = document.getElementById("acc-current-password") as HTMLInputElement;
  const newPasswordInput = document.getElementById("acc-password") as HTMLInputElement;
  const errorBox = document.getElementById("panel-account-error");
  const errorMsg = document.getElementById("panel-account-error-msg");

  if (currentAdmin) {
    nameInput.value = currentAdmin.name ?? "";
    emailInput.value = currentAdmin.email ?? "";
    phoneInput.value = currentAdmin.phone ?? "";
  }

  function showAccountError(msg: string): void {
    if (errorMsg) errorMsg.textContent = msg;
    errorBox?.classList.remove("hidden");
  }
  function hideAccountError(): void {
    errorBox?.classList.add("hidden");
  }

  document.getElementById("panel-account")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideAccountError();
    if (!currentAdmin) return;

    const name = nameInput.value.trim();
    const email = emailInput.value.trim();
    const phone = phoneInput.value.trim();
    const newPassword = newPasswordInput.value;
    const currentPassword = currentPasswordInput.value;

    if (!name) {
      showAccountError("Nama tidak boleh kosong.");
      return;
    }
    if (newPassword && newPassword.length < 6) {
      showAccountError("Password baru minimal 6 karakter.");
      return;
    }
    if (newPassword && !currentPassword) {
      showAccountError("Password saat ini wajib diisi untuk mengganti password.");
      return;
    }

    try {
      const res = await adminApiFetch(`${apiUrl}/api/owner/users/${currentAdmin.id}`, {
        method: "PATCH",
        body: JSON.stringify({ name, email: email || null, phone: phone || null }),
      });
      const json = await res.json();
      if (!res.ok) {
        showAccountError(json.error ?? "Gagal menyimpan profil.");
        return;
      }

      if (currentToken) {
        setAdminAuth(currentToken, { ...currentAdmin, name, email, phone });
      }

      if (newPassword) {
        const pwRes = await adminApiFetch(`${apiUrl}/api/owner/users/${currentAdmin.id}/password`, {
          method: "PATCH",
          body: JSON.stringify({ currentPassword, newPassword }),
        });
        const pwJson = await pwRes.json();
        if (!pwRes.ok) {
          showAccountError(pwJson.error ?? "Profil tersimpan, tapi gagal ganti password.");
          return;
        }
        currentPasswordInput.value = "";
        newPasswordInput.value = "";
      }

      window.showToast?.("Akun berhasil diperbarui");
    } catch (err) {
      console.error("[panel-account submit] gagal fetch backend:", err);
      showAccountError("Tidak bisa terhubung ke server.");
    }
  });
</script>
